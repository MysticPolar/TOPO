# ─── Supabase (web build) ────────────────────────────────────────────
# Copy this file to `.env.local` and fill in real values. These are
# safe to expose to the browser: the URL is public, the anon key is
# rate-limited and gated by RLS. Never commit `.env.local` itself.

VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-PUBLIC-ANON-KEY

# ─── Edge Function secrets (set in Supabase dashboard, NOT here) ─────
# In Supabase → Project Settings → Edge Functions → Secrets, set:
#   SUPABASE_URL                 = same as VITE_SUPABASE_URL
#   SUPABASE_SERVICE_ROLE_KEY    = service role key (server-side only)
#   GEMINI_API_KEY               = (existing, for gemini-proxy)
